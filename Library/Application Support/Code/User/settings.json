{
    "workbench.sideBar.location": "right",
    "workbench.iconTheme": "material-icon-theme",
    "editor.accessibilitySupport": "on",
    "editor.lineNumbers": "relative",
    "diffEditor.maxComputationTime": 5000,
    "security.workspace.trust.untrustedFiles": "open",
    "chatgpt.followUpQueueMode": "steer",
    "telemetry.telemetryLevel": "off",
    "comments.openView": "never",
    "diffEditor.ignoreTrimWhitespace": false,
    "workbench.editorLargeFileConfirmation": 100,
    "chat.titleBar.signIn.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "editor.fontFamily": "JetBrains Mono, SF Mono, Menlo, Monaco, 'Courier New', monospace",
    "workbench.colorTheme": "Monokai Vibrant",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.layoutControl.enabled": false,
    "cpos.saveLocation": "fixed",
    "cpos.fixedDir": "~/cp-sublime",
    "cpos.defaultLanguage": "cpp",
    "cpos.runTimeoutMs": 5000,
    "terminal.integrated.fontSize": 11
}
