{
    "shell_cmd": "set -o pipefail; mkdir -p /tmp/sublime-cpp && \"\\$HOME/.local/bin/cp-g++\" -std=gnu++20 -O2 -pipe -Wall -Wextra -Wshadow -DLOCAL \"$file\" -o \"/tmp/sublime-cpp/$file_base_name.out\" && \"/tmp/sublime-cpp/$file_base_name.out\" < \"$file_path/input.txt\" | tee \"$file_path/output.txt\"",
    "file_regex": "^(.+?):([0-9]+):([0-9]+): (.*)$",
    "working_dir": "$file_path",
    "selector": "source.c++",
}
