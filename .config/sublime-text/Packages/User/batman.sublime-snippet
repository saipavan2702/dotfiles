/*--------------------GCD------------------*/
ll gcd(ll a, ll b) {
    if (b == 0) return a;
    return gcd(b, a % b);
}

/*--------------------LCM------------------*/
ll lcm(ll a, ll b) {
    return (a / gcd(a, b)) * b;
}

const int MAXN = 1e6;
vector<int> prime(MAXN + 1, 1);
vector<int> prime_nos;

/*--------------------Sieve------------------*/
void sieve() {
    prime[0] = 0;
    prime[1] = 0;
    for (int i = 2; i * i <= MAXN; i++) {
        for (int j = i * i; j <= MAXN; j += i) {
            if (prime[j] == 1) {
                prime[j] = 0;
            }
        }
    }
    for (int i = 2; i <= MAXN; i++) {
        if (prime[i] == 1) prime_nos.push_back(i);
    }
}

/*--------------------No.of digits------------------*/
int cntdigit(int n) {
	if(n==0)
	return 1;

	return floor(log10(n)+1);
}



/*------------------isprime--------------*/
int isprime(int n) {
    bool h=0;
    for (int i=2;i*i<=n;i++) {
        if (n%i==0) {
            h=1;
        }
    }
    return h==0;
}



/*-----------------------ispalindrome---------------------------*/
bool ispalindrome(string s) {
	int n=s.size();
	for(int i=0;i<n/2;i++){
		if(s[i]!=s[n-i-1])
		return 0;
	}
	return 1;
}



