#!/usr/bin/env bash
set -euo pipefail

shopt -s nullglob
candidates=(/opt/homebrew/bin/g++-[0-9]* /usr/local/bin/g++-[0-9]*)

if ((${#candidates[@]} == 0)); then
    if command -v g++ >/dev/null 2>&1; then
        exec g++ "$@"
    fi
    echo "cp-g++: no Homebrew g++-[version] compiler found" >&2
    exit 127
fi

latest=$(
    printf '%s\n' "${candidates[@]}" |
        awk -F'g\\+\\+-' '{ print $NF "\t" $0 }' |
        sort -n |
        tail -n 1 |
        cut -f2-
)

exec "$latest" "$@"
